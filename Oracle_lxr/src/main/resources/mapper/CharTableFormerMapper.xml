<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CharTableFormerMapper">
    <select id="selectRandomList" resultType="com.example.entity.CharTable">
        SELECT * FROM chartable_former
        WHERE sWord REGEXP '^[^0-9]+$'
        ORDER BY RAND()
            LIMIT 4
    </select>

</mapper>
